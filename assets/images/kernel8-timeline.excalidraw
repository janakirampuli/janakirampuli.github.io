      "isDeleted": false,
      "boundElements": null,
      "updated": 1795161058739,
      "link": null,
      "locked": false,
      "text": "The orange bar is a load from global memory on its way. A warp waits for a load\nonly when an instruction reads the registers that the load fills.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 40,
      "containerId": null,
      "originalText": "The orange bar is a load from global memory on its way. A warp waits for a load\nonly when an instruction reads the registers that the load fills.",
      "lineHeight": 1.25
    },
