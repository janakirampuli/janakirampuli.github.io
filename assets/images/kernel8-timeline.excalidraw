      "updated": 1795161058739,
      "link": null,
      "locked": false,
      "text": "Kernel 8 loads the next tile before it computes, so the tile arrives\nduring the compute, and the store doesn't wait. The other buffer\nmakes one sync per step enough.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 55,
      "containerId": null,
      "originalText": "Kernel 8 loads the next tile before it computes, so the tile arrives\nduring the compute, and the store doesn't wait. The other buffer\nmakes one sync per step enough.",
      "lineHeight": 1.25
    },
