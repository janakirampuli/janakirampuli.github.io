    {
      "id": "t_318",
      "type": "text",
      "x": 830,
      "y": 200,
      "width": 227.9619140625,
      "height": 270,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1029973995,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795358533419,
      "link": null,
      "locked": false,
      "text": "Block 0 reads numbers from\nthe L2 cache into its shared\nmemory once.\n\nThe other 3 blocks of the\ncluster read them from the\nshared memory of SM 0, which\nNVIDIA calls distributed\nshared memory.\n\nAll 4 blocks start at the same\ntime, on SMs of one GPC.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 265,
      "containerId": null,
      "originalText": "Block 0 reads numbers from\nthe L2 cache into its shared\nmemory once.\n\nThe other 3 blocks of the\ncluster read them from the\nshared memory of SM 0, which\nNVIDIA calls distributed\nshared memory.\n\nAll 4 blocks start at the same\ntime, on SMs of one GPC.",
      "lineHeight": 1.25
    },
