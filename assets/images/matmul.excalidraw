      "updated": 1794752044513,
      "link": null,
      "locked": false,
      "text": "C[i][j] = A[i][0] · B[0][j]\n          + A[i][1] · B[1][j]\n          + ...\n          + A[i][K-1] · B[K-1][j]",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 94,
      "containerId": null,
      "originalText": "C[i][j] = A[i][0] · B[0][j]\n          + A[i][1] · B[1][j]\n          + ...\n          + A[i][K-1] · B[K-1][j]",
      "lineHeight": 1.25
    },
