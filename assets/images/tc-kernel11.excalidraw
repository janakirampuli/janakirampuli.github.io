      "boundElements": null,
      "updated": 1795458574180,
      "link": null,
      "locked": false,
      "text": "At each step, the block copies a 128 by 16 tile of A and a 16 by 128 tile of B\ninto shared memory. Each of its 8 warps computes a 64 by 32 tile of C.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
