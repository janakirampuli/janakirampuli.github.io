    {
      "id": "4Ne7du2fkWEcAbrrfloPy",
      "type": "text",
      "x": 40,
      "y": 464,
      "width": 134.65625,
      "height": 20,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1797931034,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795623438278,
      "link": null,
      "locked": false,
      "text": "64 FFMAs at each k.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "64 FFMAs at each k.",
      "lineHeight": 1.25
    },
    {
      "id": "edw5aBz5vRl0nWLa1Cr8_",
      "type": "text",
      "x": 560,
      "y": 464,
      "width": 444.828125,
      "height": 20,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1672275590,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795623438278,
      "link": null,
      "locked": false,
      "text": "32 FFMA2s at each k. The pair of s_A sits in 2 neighboring registers,",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "32 FFMA2s at each k. The pair of s_A sits in 2 neighboring registers,",
      "lineHeight": 1.25
    },
    {
      "id": "_7JQkAcObizRpw6EYz67K",
      "type": "text",
      "x": 560,
      "y": 486,
      "width": 289.2734375,
      "height": 20,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 652160218,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795623438278,
      "link": null,
      "locked": false,
      "text": "and both halves use the same number of s_B.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "and both halves use the same number of s_B.",
      "lineHeight": 1.25
    },
    {
      "id": "_pHNlfRRqZ13isYvVRz7p",
      "type": "text",
      "x": 40,
      "y": 554,
      "width": 235.5546875,
      "height": 27.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 463087046,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795623438278,
      "link": null,
      "locked": false,
      "text": "One scheduler, tick by tick",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 20,
      "containerId": null,
      "originalText": "One scheduler, tick by tick",
      "lineHeight": 1.25
    },
    {
      "id": "ttTiPDr-hCAA2opNTJxjJ",
      "type": "text",
      "x": 40,
      "y": 586,
      "width": 690.5,
      "height": 20,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 517505434,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795623438278,
      "link": null,
      "locked": false,
      "text": "On each tick the scheduler starts one instruction. The FP32 cores of its quarter do 32 multiply-adds per tick.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "On each tick the scheduler starts one instruction. The FP32 cores of its quarter do 32 multiply-adds per tick.",
      "lineHeight": 1.25
    },
