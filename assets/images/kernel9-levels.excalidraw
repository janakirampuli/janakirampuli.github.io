    {
      "id": "t_245",
      "type": "text",
      "x": 746,
      "y": 670,
      "width": 170.6015625,
      "height": 160,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2053169892,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795178681444,
      "link": null,
      "locked": false,
      "text": "Its 4 squares sit together\nin its registers as 8 by 8\nresults, one square from\neach sub-piece.\n\nAt each k, the thread loads\n8 + 8 numbers and does\n8 x 8 = 64 FFMAs.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 155,
      "containerId": null,
      "originalText": "Its 4 squares sit together\nin its registers as 8 by 8\nresults, one square from\neach sub-piece.\n\nAt each k, the thread loads\n8 + 8 numbers and does\n8 x 8 = 64 FFMAs.",
      "lineHeight": 1.25
    },
