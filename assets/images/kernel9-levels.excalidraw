      "updated": 1795178681444,
      "link": null,
      "locked": false,
      "text": "The block splits its tile of C among its warps. Each warp splits its piece into\nsub-pieces, and each thread computes one small square in every sub-piece.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 40,
      "containerId": null,
      "originalText": "The block splits its tile of C among its warps. Each warp splits its piece into\nsub-pieces, and each thread computes one small square in every sub-piece.",
      "lineHeight": 1.25
    },
