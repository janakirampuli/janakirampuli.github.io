    {
      "id": "t_156",
      "type": "text",
      "x": 864,
      "y": 260,
      "width": 153.265625,
      "height": 120,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 859046620,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795178681444,
      "link": null,
      "locked": false,
      "text": "The dashed lines split\nthe piece into 4\nsub-pieces. In each one,\nthe 32 threads of the\nwarp sit as 4 rows of 8\nsquares of 4 by 4.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 115,
      "containerId": null,
      "originalText": "The dashed lines split\nthe piece into 4\nsub-pieces. In each one,\nthe 32 threads of the\nwarp sit as 4 rows of 8\nsquares of 4 by 4.",
      "lineHeight": 1.25
    },
    {
      "id": "t_157",
      "type": "text",
      "x": 864,
      "y": 400,
      "width": 155.515625,
      "height": 40,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1277634788,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795178681444,
      "link": null,
      "locked": false,
      "text": "Thread 0 is dark red,\nand thread 1 is light red.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 35,
      "containerId": null,
      "originalText": "Thread 0 is dark red,\nand thread 1 is light red.",
      "lineHeight": 1.25
    },
    {
      "id": "t_158",
      "type": "text",
      "x": 450,
      "y": 464,
      "width": 411.4609375,
      "height": 40,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1273448284,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795178681444,
      "link": null,
      "locked": false,
      "text": "Neighboring threads have neighboring squares, so threads 0 to 7\nread one unbroken run of s_B at each k.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 35,
      "containerId": null,
      "originalText": "Neighboring threads have neighboring squares, so threads 0 to 7\nread one unbroken run of s_B at each k.",
      "lineHeight": 1.25
    },
    {
      "id": "t_159",
      "type": "text",
      "x": 410,
      "y": 550,
