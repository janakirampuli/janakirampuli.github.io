      "isDeleted": false,
      "boundElements": null,
      "updated": 1795623433357,
      "link": null,
      "locked": false,
      "text": "The block splits its tile of C among its warps. Each warp splits its piece into 4 sub-pieces,",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 17,
      "containerId": null,
      "originalText": "The block splits its tile of C among its warps. Each warp splits its piece into 4 sub-pieces,",
      "lineHeight": 1.25
    },
    {
      "id": "YNAwN6qn0PK63iNIbX90Q",
