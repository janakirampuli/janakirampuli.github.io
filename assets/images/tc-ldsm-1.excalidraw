      "updated": 1795539955503,
      "link": null,
      "locked": false,
      "text": "A 16 by 16 piece of s_A: 16 rows of the warp's tile, 16 values of k.\nEach row of a square is 8 numbers side by side, which is 16 bytes.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 40,
      "containerId": null,
      "originalText": "A 16 by 16 piece of s_A: 16 rows of the warp's tile, 16 values of k.\nEach row of a square is 8 numbers side by side, which is 16 bytes.",
