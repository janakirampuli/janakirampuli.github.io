    {
      "id": "t_251",
      "type": "text",
      "x": 440,
      "y": 656,
      "width": 208.9423828125,
      "height": 45,
      "angle": 0,
      "strokeColor": "#2b8a3e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 163316610,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794791484162,
      "link": null,
      "locked": false,
      "text": "C: the 32 threads of the warp\nare 32 rows of column j",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 40,
      "containerId": null,
      "originalText": "C: the 32 threads of the warp\nare 32 rows of column j",
      "lineHeight": 1.25
    },
    {
      "id": "t_252",
      "type": "text",
      "x": 790,
      "y": 270,
      "width": 231.9609375,
      "height": 90,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 43609502,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794791484162,
      "link": null,
      "locked": false,
      "text": "Dark cells are the numbers\nthat the warp reads. Light bands\nare the 32-byte sectors that\nthe GPU moves to deliver them.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 85,
      "containerId": null,
      "originalText": "Dark cells are the numbers\nthat the warp reads. Light bands\nare the 32-byte sectors that\nthe GPU moves to deliver them.",
      "lineHeight": 1.25
    },
    {
      "id": "t_253",
      "type": "text",
      "x": 790,
      "y": 400,
      "width": 212.4404296875,
      "height": 90,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 540296002,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794791484162,
      "link": null,
      "locked": false,
      "text": "A[i][k] to A[i + 31][k] sit in\n32 rows that are 16 KB apart,\nso each needs its own sector:\n32 sectors.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 85,
      "containerId": null,
      "originalText": "A[i][k] to A[i + 31][k] sit in\n32 rows that are 16 KB apart,\nso each needs its own sector:\n32 sectors.",
      "lineHeight": 1.25
    },
    {
      "id": "t_254",
      "type": "text",
      "x": 790,
      "y": 530,
      "width": 219.4365234375,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1586891230,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794791484162,
      "link": null,
      "locked": false,
      "text": "B[k][j] is the same number for\nall 32 threads: 1 sector.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 40,
      "containerId": null,
      "originalText": "B[k][j] is the same number for\nall 32 threads: 1 sector.",
      "lineHeight": 1.25
    },
    {
      "id": "t_255",
      "type": "text",
      "x": 790,
      "y": 610,
      "width": 212.734375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 84839170,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794791484162,
      "link": null,
      "locked": false,
      "text": "33 sectors, or 1,056 bytes,\nmove to deliver 132 bytes.",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 44,
      "containerId": null,
      "originalText": "33 sectors, or 1,056 bytes,\nmove to deliver 132 bytes.",
      "lineHeight": 1.25
    },
