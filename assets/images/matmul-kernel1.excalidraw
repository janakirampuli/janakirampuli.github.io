      "isDeleted": false,
      "boundElements": null,
      "updated": 1794791484162,
      "link": null,
      "locked": false,
      "text": "Column k moves one to the right at\neach step, so over the loop each\nthread reads its whole row of A.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 55,
      "containerId": null,
      "originalText": "Column k moves one to the right at\neach step, so over the loop each\nthread reads its whole row of A.",
      "lineHeight": 1.25
    },
