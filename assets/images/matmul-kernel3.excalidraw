      "fontSize": 18,
      "fontFamily": 1,
      "text": "1. The block copies tile i of A into s_A\n    and tile i of B into s_B.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. The block copies tile i of A into s_A\n    and tile i of B into s_B.",
