      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795623435923,
      "link": null,
      "locked": false,
      "text": "Kernel 9: each thread's columns come as 2 groups of 4, 32 columns apart",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 17,
