      "updated": 1795183397330,
      "link": null,
      "locked": false,
      "text": "In the first load, thread 0 and thread 4 both use banks 0 to 3, and the same goes for\nthreads 1 and 5, 2 and 6, and 3 and 7, so the load takes twice the passes.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 35,
      "containerId": null,
      "originalText": "In the first load, thread 0 and thread 4 both use banks 0 to 3, and the same goes for\nthreads 1 and 5, 2 and 6, and 3 and 7, so the load takes twice the passes.",
      "lineHeight": 1.25
    },
