      "isDeleted": false,
      "boundElements": null,
      "updated": 1795623435923,
      "link": null,
      "locked": false,
      "text": "Each box is 4 neighboring numbers of a row of s_B, and the number in it is the thread that loads it.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "Each box is 4 neighboring numbers of a row of s_B, and the number in it is the thread that loads it.",
      "lineHeight": 1.25
    },
    {
      "id": "aXWgQpzP0RXFSEYHd4G9s",
      "type": "text",
      "x": 40,
      "y": 84,
      "width": 625.2421875,
      "height": 20,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
