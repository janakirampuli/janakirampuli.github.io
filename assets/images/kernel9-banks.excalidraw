    {
      "id": "6jViCLw8UxiVhJlnM1O4z",
      "type": "text",
      "x": 180,
      "y": 360,
      "width": 491.4453125,
      "height": 20,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 768927827,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795623435923,
      "link": null,
      "locked": false,
      "text": "Threads 0 and 4 use the same banks, and so do 1 and 5, 2 and 6, and 3 and 7.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "Threads 0 and 4 use the same banks, and so do 1 and 5, 2 and 6, and 3 and 7.",
      "lineHeight": 1.25
    },
    {
      "id": "6Y5GDPYvKjYwVZ4hXuce-",
      "type": "text",
      "x": 180,
      "y": 382,
      "width": 488.5390625,
      "height": 20,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1955248733,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795623435923,
      "link": null,
      "locked": false,
      "text": "Each bank serves two threads, one after the other, so the load takes 2 passes.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "Each bank serves two threads, one after the other, so the load takes 2 passes.",
      "lineHeight": 1.25
    },
    {
      "id": "Pm6jZbVXKQSnwqO3xv13i",
