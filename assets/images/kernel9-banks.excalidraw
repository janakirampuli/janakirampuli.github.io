    },
    {
      "id": "2Zy_UvEWuzpdfJaRWZREr",
      "type": "text",
      "x": 40,
      "y": 62,
      "width": 632.3203125,
      "height": 20,
      "angle": 0,
      "strokeColor": "#495057",
