      "link": null,
      "locked": false,
      "text": "Which numbers of s_B threads 0 to 7 load at one k",
      "fontSize": 26,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 24,
      "containerId": null,
      "originalText": "Which numbers of s_B threads 0 to 7 load at one k",
      "lineHeight": 1.25
    },
    {
      "id": "t_1",
      "type": "text",
      "x": 20,
      "y": 52,
      "width": 601.3916015625,
      "height": 90,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1433386898,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795183397330,
      "link": null,
      "locked": false,
      "text": "Each thread loads 8 numbers of s_B with two loads of 4. Each box is 4 neighboring\nnumbers in a row of s_B, and the number in it is the thread that loads them.\n32 numbers in a row use each of the 32 banks once, so the first 8 boxes use every\nbank once, and the next 8 boxes use the same banks again.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 85,
      "containerId": null,
      "originalText": "Each thread loads 8 numbers of s_B with two loads of 4. Each box is 4 neighboring\nnumbers in a row of s_B, and the number in it is the thread that loads them.\n32 numbers in a row use each of the 32 banks once, so the first 8 boxes use every\nbank once, and the next 8 boxes use the same banks again.",
      "lineHeight": 1.25
    },
