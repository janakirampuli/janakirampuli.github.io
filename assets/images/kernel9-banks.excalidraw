    {
      "id": "j2wMUGlRJm5yT4Hg2oZwR",
      "type": "text",
      "x": 180,
      "y": 630,
      "width": 491.4375,
      "height": 20,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1083259187,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795623435923,
      "link": null,
      "locked": false,
      "text": "Every thread has banks of its own, so the load takes 1 pass. The second load,",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "Every thread has banks of its own, so the load takes 1 pass. The second load,",
      "lineHeight": 1.25
    },
    {
      "id": "bPz1AMk4QxMtLVsZDEWdF",
      "type": "text",
      "x": 180,
      "y": 652,
      "width": 280.671875,
      "height": 20,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 924870525,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795623435923,
      "link": null,
      "locked": false,
      "text": "from the next 8 boxes, works the same way.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "from the next 8 boxes, works the same way.",
      "lineHeight": 1.25
    },
    {
      "id": "7XOjyuqgxbO9GpTrCo5by",
      "type": "text",
      "x": 40,
      "y": 700,
      "width": 463.18359375,
      "height": 18.75,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 387554003,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795623435923,
      "link": null,
      "locked": false,
      "text": "Outlined boxes are the first load. The gray boxes are read by the second load.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "Outlined boxes are the first load. The gray boxes are read by the second load.",
      "lineHeight": 1.25
    },
    {
      "id": "UPleIg3jk0zdEhk9gdT1o",
      "type": "text",
      "x": 40,
      "y": 722,
      "width": 683.15185546875,
      "height": 18.75,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 889221085,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795623435923,
      "link": null,
      "locked": false,
      "text": "Threads 8 to 31 read the same numbers as threads 0 to 7, and the banks send those numbers to all of them at once.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "Threads 8 to 31 read the same numbers as threads 0 to 7, and the banks send those numbers to all of them at once.",
