      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795623435923,
      "link": null,
      "locked": false,
      "text": "One float4 load reads one box. 4 neighboring numbers sit in 4 neighboring banks, so the 32 banks",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "One float4 load reads one box. 4 neighboring numbers sit in 4 neighboring banks, so the 32 banks",
      "lineHeight": 1.25
    },
