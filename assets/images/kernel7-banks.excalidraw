      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795359178674,
      "link": null,
      "locked": false,
      "text": "Shared memory has 32 banks. Number i sits in bank i % 32, and in each pass\nevery bank gives out or takes in one 4-byte number.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 40,
      "containerId": null,
      "originalText": "Shared memory has 32 banks. Number i sits in bank i % 32, and in each pass\nevery bank gives out or takes in one 4-byte number.",
      "lineHeight": 1.25
    },
