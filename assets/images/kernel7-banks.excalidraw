      "text": "Banks of shared memory",
      "fontSize": 26,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 24,
      "containerId": null,
      "originalText": "Banks of shared memory",
      "lineHeight": 1.25
    },
    {
      "id": "t_1",
      "type": "text",
      "x": 20,
      "y": 52,
      "width": 553.8955078125,
      "height": 45,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
