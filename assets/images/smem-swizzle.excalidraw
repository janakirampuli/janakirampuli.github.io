      "text": "Swizzling, on a small shared memory with 8 banks",
      "fontSize": 26,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 24,
      "containerId": null,
      "originalText": "Swizzling, on a small shared memory with 8 banks",
      "lineHeight": 1.25
    },
    {
      "id": "t_1",
      "type": "text",
      "x": 20,
      "y": 52,
      "width": 740.8037109375,
      "height": 45,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 815543150,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795364063534,
      "link": null,
      "locked": false,
      "text": "An 8 by 8 matrix is stored row by row, one row of the matrix in each row of shared memory.\nEach box is one number of the matrix, labelled with its row and column, and each color is one column.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 40,
      "containerId": null,
      "originalText": "An 8 by 8 matrix is stored row by row, one row of the matrix in each row of shared memory.\nEach box is one number of the matrix, labelled with its row and column, and each color is one column.",
      "lineHeight": 1.25
    },
