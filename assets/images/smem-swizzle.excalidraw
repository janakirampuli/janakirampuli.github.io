      "isDeleted": false,
      "boundElements": null,
      "updated": 1795364063534,
      "link": null,
      "locked": false,
      "text": "Each row holds the same numbers in a\ndifferent order. Every column of the matrix\nnow has one number in each bank, so reading\na column takes 1 pass. A row still reads in\n1 pass.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 95,
      "containerId": null,
      "originalText": "Each row holds the same numbers in a\ndifferent order. Every column of the matrix\nnow has one number in each bank, so reading\na column takes 1 pass. A row still reads in\n1 pass.",
      "lineHeight": 1.25
    },
