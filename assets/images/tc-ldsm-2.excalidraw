    {
      "id": "t_283",
      "type": "text",
      "x": 20,
      "y": 52,
      "width": 460.3447265625,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1107518957,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795543510275,
      "link": null,
      "locked": false,
      "text": "Each cell of square 0 shows the lane that gets it, in register a[0].\nRow 0 goes to lanes 0 to 3, row 1 to lanes 4 to 7, and so on.\nThe other 3 squares go the same way into a[1], a[2] and a[3].",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 62,
      "containerId": null,
      "originalText": "Each cell of square 0 shows the lane that gets it, in register a[0].\nRow 0 goes to lanes 0 to 3, row 1 to lanes 4 to 7, and so on.\nThe other 3 squares go the same way into a[1], a[2] and a[3].",
      "lineHeight": 1.25
    },
