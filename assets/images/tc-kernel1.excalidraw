      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795164107160,
      "link": null,
      "locked": false,
      "text": "The warp walks along its 16 rows of A and its 8 columns of B,\n16 values of k at a time. At each step, every lane loads its\nfragment numbers from global memory, and the warp issues one mma.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 62,
      "containerId": null,
      "originalText": "The warp walks along its 16 rows of A and its 8 columns of B,\n16 values of k at a time. At each step, every lane loads its\nfragment numbers from global memory, and the warp issues one mma.",
      "lineHeight": 1.25
    },
