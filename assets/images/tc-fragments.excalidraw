    },
    {
      "id": "t_1",
      "type": "text",
      "x": 20,
      "y": 52,
      "width": 537.345703125,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 596410008,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795164107160,
      "link": null,
      "locked": false,
      "text": "The number in each cell is the lane of the warp that holds it in its registers.\nLane 0 is dark, and lane 1 is light red. Each lane holds 8 numbers of A,\n4 of B and 4 of C.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 62,
      "containerId": null,
      "originalText": "The number in each cell is the lane of the warp that holds it in its registers.\nLane 0 is dark, and lane 1 is light red. Each lane holds 8 numbers of A,\n4 of B and 4 of C.",
      "lineHeight": 1.25
    },
