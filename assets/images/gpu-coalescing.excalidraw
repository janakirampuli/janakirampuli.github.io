      "updated": 1795358533419,
      "link": null,
      "locked": false,
      "text": "Threads 8 to 31 do the same. The warp moves 32 sectors, which is 1,024 bytes,\nand uses only the 128 green bytes. The red bytes move for nothing.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 40,
      "containerId": null,
      "originalText": "Threads 8 to 31 do the same. The warp moves 32 sectors, which is 1,024 bytes,\nand uses only the 128 green bytes. The red bytes move for nothing.",
      "lineHeight": 1.25
    },
