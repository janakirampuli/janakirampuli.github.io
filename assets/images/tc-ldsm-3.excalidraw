      "boundElements": null,
      "updated": 1795543510275,
      "link": null,
      "locked": false,
      "text": "For B, ldmatrix.trans hands out the columns",
      "fontSize": 26,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 24,
      "containerId": null,
      "originalText": "For B, ldmatrix.trans hands out the columns",
      "lineHeight": 1.25
    },
    {
      "id": "t_438",
      "type": "text",
      "x": 20,
      "y": 52,
      "width": 598.904296875,
      "height": 67.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1417980717,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795543510275,
      "link": null,
      "locked": false,
      "text": "Each row of s_B runs along n, but mma wants pairs along k, which sit in a column.\nWith .trans, column 0 goes to lanes 0 to 3, column 1 to lanes 4 to 7, and so on.\nOne load fills the B fragments of 2 neighboring 16 by 8 pieces.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 62,
      "containerId": null,
      "originalText": "Each row of s_B runs along n, but mma wants pairs along k, which sit in a column.\nWith .trans, column 0 goes to lanes 0 to 3, column 1 to lanes 4 to 7, and so on.\nOne load fills the B fragments of 2 neighboring 16 by 8 pieces.",
      "lineHeight": 1.25
    },
