      "locked": false,
      "text": "How the threads of a 2D block are put in warps",
      "fontSize": 26,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 24,
      "containerId": null,
      "originalText": "How the threads of a 2D block are put in warps",
      "lineHeight": 1.25
    },
    {
      "id": "t_47",
      "type": "text",
      "x": 40,
      "y": 52,
      "width": 812.619140625,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 874443439,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794752044513,
      "link": null,
      "locked": false,
      "text": "The GPU numbers the threads x + y × blockDim.x, so x changes fastest, and each run of 32 numbers is one warp",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 17,
      "containerId": null,
      "originalText": "The GPU numbers the threads x + y × blockDim.x, so x changes fastest, and each run of 32 numbers is one warp",
      "lineHeight": 1.25
    },
